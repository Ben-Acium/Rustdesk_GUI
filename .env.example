# Generate with:  docker compose run --rm rustdeskgui hash
# Keep the single quotes: the hash contains $ characters that Compose would
# otherwise try to interpolate.
RDGUI_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=2$REPLACE$REPLACE'

# This host's LAN IP plus hbbs's NAT port (the rendezvous port minus one).
# Must NOT be 127.0.0.1 - hbbs will not answer presence queries over loopback.
# Find it with: hostname -I
RDGUI_HBBS_ADDR=192.0.2.10:21115

# Path to the hbbs data directory (the one holding db_v2.sqlite3), relative to
# this file or absolute. Default assumes ../rustdesk-server/data.
#RDGUI_HBBS_DATA=/home/youruser/rustdesk-server/data

# Bind to loopback only and reach the UI over an SSH tunnel:
#RDGUI_LISTEN=127.0.0.1:8443

# Set to 0 to disable reverse-DNS hostname lookups for device names.
#RDGUI_RDNS=0

# --- Saved device passwords (optional) ----------------------------------
# Enables "remember this device's password". What is stored is the per-device
# credential h1 = SHA256(password||salt) that the RustDesk client itself
# caches, never the password you type, and it is encrypted with this key.
#
# Generate with:  docker compose run --rm rustdeskgui genkey
#
# Keep this key OUT of the data volume - that is the whole point. A copy of
# the database is then not enough to recover any device credential. Losing the
# key does not lock you out of this console; it only makes the saved device
# passwords unreadable, and each one is re-saved on the next connection.
# Leave it unset and the feature stays off.
#RDGUI_SECRET_KEY=REPLACE

# --- Intel: device location (optional) ----------------------------------
# Intel collects a device's hardware, software and network details over a
# terminal connection. Everything it gathers comes from the device itself,
# except the approximate location, which is looked up from the public address
# hbbs recorded for that device.
#
# Defaulted ON, using ip-api.com's free endpoint. What that means in practice:
#   - Collecting a device sends that device's public IP to ip-api.com.
#     Nothing else is sent: not the device ID, not its name, not anything the
#     probe collected.
#   - The free tier is HTTP only, so the query is not encrypted in transit.
#   - Private and loopback addresses are never looked up at all.
#
# Set to "off" to disable it; devices still report their own time zone, which
# gives a coarse location without involving anyone else. Any URL containing an
# {ip} placeholder and returning ip-api-compatible JSON also works.
#RDGUI_GEOIP_URL=off

# --- Browser client (optional) ------------------------------------------
# The address you type in the browser, e.g. an IP or hostname. It is added to
# the self-signed certificate so that one accepted exception covers both the
# page and the WebSocket proxied through the same origin.
#RDGUI_PUBLIC_HOST=64.58.102.35
#
# Where hbbs/hbbr listen for WebSocket, as seen from this container. The
# browser never contacts these directly.
#RDGUI_HBBS_WS=127.0.0.1:21118
#RDGUI_HBBR_WS=127.0.0.1:21119
#
# A plaintext listener, only if you specifically want one. It is no longer
# needed for the browser client and disables the session cookie's Secure flag.
#RDGUI_HTTP_LISTEN=:8444

# Codec seeded into the browser client on first visit. Devices often pick AV1
# when offered everything, which Chrome accepts but does not reliably render.
# One of: auto, vp9, vp8, h264, h265, av1. Empty disables the seeding.
#RDGUI_PREFER_CODEC=vp8
